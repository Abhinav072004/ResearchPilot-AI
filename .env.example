# Local Docker Compose. Replace before deployment. Use a URL-safe password.
POSTGRES_PASSWORD=local-development-only
RP_ENVIRONMENT=development
RP_SECURE_COOKIE=false
RP_ORIGIN=http://localhost:8080
RP_SITE_ADDRESS=http://:80
RP_HTTP_BIND=127.0.0.1:8080
RP_HTTPS_BIND=127.0.0.1:8443

# For managed PostgreSQL and Redis, set explicit URLs.
# RP_DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=verify-full
# RP_REDIS_URL=rediss://user:password@host:6379/0
# RP_S3_BUCKET=
# RP_S3_ENDPOINT=
# RP_CLAMD_HOST=scanner
# RP_GROBID_URL=
# RP_OPENALEX_KEY=
# RP_SEMANTIC_SCHOLAR_KEY=
# RP_CORE_KEY=
# RP_LLM_URL=
# RP_LLM_KEY=
# RP_LLM_MODEL=
# RP_LLM_MAX_CALLS=1
# RP_LLM_INPUT_PER_MILLION=
# RP_LLM_OUTPUT_PER_MILLION=
