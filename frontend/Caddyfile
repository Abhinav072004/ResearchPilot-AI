{
	admin off
}
{$RP_SITE_ADDRESS:http://:80} {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
    request_body {
        max_size 16MB
    }
    @api path /api/* /health/*
    handle @api {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
