# Copy to the deployment root as .env and keep it private.
RP_SITE_ADDRESS=https://research.example.org
RP_ORIGIN=https://research.example.org
RP_DATABASE_URL=postgresql+psycopg://user:password@postgres.example.org/researchpilot?sslmode=verify-full
RP_REDIS_URL=rediss://user:password@redis.example.org:6379/0
RP_S3_BUCKET=replace-with-private-bucket
AWS_DEFAULT_REGION=us-east-1
